{
  "name": "household (linked-findings pilot, scenario main)",
  "description": "Fictional two-stage household-report workflow from PROTOCOL.md sections 3-4 (scenario main, lambda = 1). Release r1 is intake findings, release r2 is follow-up findings; the hidden target is the reserve band. Every probability is invented. The acceptance test checks that this spec reproduces the frozen oracle values exactly.",
  "target": {"name": "reserve_band", "values": ["low", "medium", "high"], "prior": ["0.40", "0.35", "0.25"]},
  "fields": [
    {"name": "r1.income_pattern", "stage": "r1", "values": ["regular", "irregular"], "parents": ["reserve_band"],
     "cpt": {"low": ["0.50", "0.50"], "medium": ["0.65", "0.35"], "high": ["0.75", "0.25"]}},
    {"name": "r1.essential_share", "stage": "r1", "values": ["under_50", "50_70", "over_70"], "parents": ["reserve_band"],
     "cpt": {"low": ["0.15", "0.40", "0.45"], "medium": ["0.30", "0.45", "0.25"], "high": ["0.50", "0.35", "0.15"]},
     "coarsenings": {"coarse": {"under_50": "up_to_70", "50_70": "up_to_70", "over_70": "over_70"}}},
    {"name": "r1.event_code", "stage": "r1",
     "values": ["none", "vehicle_minor", "vehicle_major", "medical_minor", "medical_major", "home_minor", "home_major"],
     "p": ["1/2", "1/10", "1/15", "1/10", "1/15", "1/10", "1/15"],
     "coarsenings": {"type": {"none": "none", "vehicle_minor": "vehicle", "vehicle_major": "vehicle",
                              "medical_minor": "medical", "medical_major": "medical", "home_minor": "home", "home_major": "home"}}},
    {"name": "r1.payment_flag", "stage": "r1", "values": ["none", "late_utility", "overdraft_fee", "both"], "parents": ["reserve_band"],
     "cpt": {"low": ["0.45", "0.20", "0.20", "0.15"], "medium": ["0.65", "0.15", "0.12", "0.08"], "high": ["0.85", "0.07", "0.06", "0.02"]},
     "coarsenings": {"any": {"none": "none", "late_utility": "any", "overdraft_fee": "any", "both": "any"}}},
    {"name": "r1.contact_channel", "stage": "r1", "values": ["email", "phone", "post"], "p": ["0.60", "0.30", "0.10"]},
    {"name": "r2.resolution", "stage": "r2", "values": ["not_applicable", "settled_in_full", "instalment_plan", "outstanding"],
     "parents": ["r1.event_code", "reserve_band"],
     "cpt": {
       "none|*": ["1", "0", "0", "0"],
       "vehicle_minor|low": ["0", "0.60", "0.25", "0.15"], "vehicle_minor|medium": ["0", "0.75", "0.18", "0.07"], "vehicle_minor|high": ["0", "0.85", "0.12", "0.03"],
       "medical_minor|low": ["0", "0.60", "0.25", "0.15"], "medical_minor|medium": ["0", "0.75", "0.18", "0.07"], "medical_minor|high": ["0", "0.85", "0.12", "0.03"],
       "home_minor|low": ["0", "0.60", "0.25", "0.15"], "home_minor|medium": ["0", "0.75", "0.18", "0.07"], "home_minor|high": ["0", "0.85", "0.12", "0.03"],
       "vehicle_major|low": ["0", "0.00", "0.45", "0.55"], "vehicle_major|medium": ["0", "0.25", "0.55", "0.20"], "vehicle_major|high": ["0", "0.80", "0.17", "0.03"],
       "medical_major|low": ["0", "0.00", "0.45", "0.55"], "medical_major|medium": ["0", "0.25", "0.55", "0.20"], "medical_major|high": ["0", "0.80", "0.17", "0.03"],
       "home_major|low": ["0", "0.00", "0.45", "0.55"], "home_major|medium": ["0", "0.25", "0.55", "0.20"], "home_major|high": ["0", "0.80", "0.17", "0.03"]
     },
     "coarsenings": {"coarse": {"not_applicable": "not_applicable", "settled_in_full": "arranged", "instalment_plan": "arranged", "outstanding": "outstanding"}}},
    {"name": "r2.payment_flag", "stage": "r2", "values": ["none", "late_utility", "overdraft_fee", "both"], "parents": ["reserve_band"],
     "cpt": {"low": ["0.50", "0.18", "0.18", "0.14"], "medium": ["0.70", "0.13", "0.10", "0.07"], "high": ["0.88", "0.06", "0.05", "0.01"]},
     "coarsenings": {"any": {"none": "none", "late_utility": "any", "overdraft_fee": "any", "both": "any"}}},
    {"name": "r2.goal", "stage": "r2", "values": ["none", "build_buffer", "reduce_debt", "major_purchase"], "parents": ["reserve_band"],
     "cpt": {"low": ["0.25", "0.35", "0.30", "0.10"], "medium": ["0.30", "0.25", "0.25", "0.20"], "high": ["0.35", "0.10", "0.15", "0.40"]}},
    {"name": "r2.document_status", "stage": "r2", "values": ["complete", "missing_id", "missing_income_proof"], "p": ["0.70", "0.15", "0.15"]}
  ],
  "items": [
    {"name": "budget_session", "no_action": ["no"],
     "rules": [{"when": {"any": [{"field": "r1.payment_flag", "ne": "none"}, {"field": "r2.payment_flag", "ne": "none"}]}, "value": "yes"},
               {"value": "no"}]},
    {"name": "overdraft_guidance", "no_action": ["no"],
     "rules": [{"when": {"any": [{"field": "r1.payment_flag", "in": ["overdraft_fee", "both"]},
                                 {"field": "r2.payment_flag", "in": ["overdraft_fee", "both"]}]}, "value": "yes"},
               {"value": "no"}]},
    {"name": "essential_cost_review", "no_action": ["no"],
     "rules": [{"when": {"field": "r1.essential_share", "eq": "over_70"}, "value": "yes"}, {"value": "no"}]},
    {"name": "expense_referral", "no_action": ["none"],
     "rules": [{"when": {"all": [{"field": "r1.event_code", "ne": "none"},
                                 {"field": "r2.resolution", "in": ["instalment_plan", "outstanding"]}]},
                "value": {"field": "r1.event_code", "map": {"none": "none", "vehicle_minor": "vehicle", "vehicle_major": "vehicle",
                                                             "medical_minor": "medical", "medical_major": "medical",
                                                             "home_minor": "home", "home_major": "home"}}},
               {"value": "none"}]},
    {"name": "hardship_review", "no_action": ["no"],
     "rules": [{"when": {"all": [{"field": "r1.event_code", "in": ["vehicle_major", "medical_major", "home_major"]},
                                 {"field": "r2.resolution", "eq": "outstanding"}]}, "value": "yes"},
               {"value": "no"}]},
    {"name": "plan_monitoring", "no_action": ["no"],
     "rules": [{"when": {"field": "r2.resolution", "eq": "instalment_plan"}, "value": "yes"}, {"value": "no"}]},
    {"name": "goal_module", "no_action": ["none"], "rules": [{"value": {"field": "r2.goal"}}]},
    {"name": "documents_request", "no_action": ["none"],
     "rules": [{"value": {"field": "r2.document_status", "map": {"complete": "none", "missing_id": "id", "missing_income_proof": "income_proof"}}}]},
    {"name": "contact_channel", "no_action": [], "rules": [{"value": {"field": "r1.contact_channel"}}]}
  ],
  "views": {
    "A": {"description": "release 1 only",
          "fields": {"r1.income_pattern": "keep", "r1.essential_share": "keep", "r1.event_code": "keep", "r1.payment_flag": "keep", "r1.contact_channel": "keep"}},
    "B": {"description": "release 2 only",
          "fields": {"r2.resolution": "keep", "r2.payment_flag": "keep", "r2.goal": "keep", "r2.document_status": "keep"}},
    "C": {"description": "both releases, linked",
          "fields": {"r1.income_pattern": "keep", "r1.essential_share": "keep", "r1.event_code": "keep", "r1.payment_flag": "keep", "r1.contact_channel": "keep",
                     "r2.resolution": "keep", "r2.payment_flag": "keep", "r2.goal": "keep", "r2.document_status": "keep"}},
    "D": {"description": "both releases after the declared coarsening",
          "fields": {"r1.income_pattern": "keep",
                     "r1.essential_share": {"coarsen": "coarse", "as": "r1.essential_share_coarse"},
                     "r1.event_code": {"coarsen": "type", "as": "r1.event_type"},
                     "r1.payment_flag": {"coarsen": "any", "as": "r1.payment_difficulty"},
                     "r1.contact_channel": "keep",
                     "r2.resolution": {"coarsen": "coarse", "as": "r2.resolution_coarse"},
                     "r2.payment_flag": {"coarsen": "any", "as": "r2.payment_difficulty"},
                     "r2.goal": "keep", "r2.document_status": "keep"}},
    "E": {"description": "checklist answers only", "items": "all"}
  },
  "search": {"max_designs": 5000, "items_plus_fields": 1}
}
