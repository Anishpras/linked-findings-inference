{
  "name": "grocery delivery (fictional, three stages)",
  "description": "A fictional grocery-delivery pipeline with three stages that each pass a few findings downstream: order (from the customer), picking (from the warehouse) and delivery (from the driver). The hidden attribute is whether the household has young children (binary). A latent field, household size, is never released but drives basket size and bulk items. One invented hard constraint spans stages: households without young children never ask for 'no bell' on an afternoon slot, so linking the order and delivery stages can rule a value out. Every probability is invented; nothing here describes a real service or real customers.",
  "target": {"name": "young_children", "values": ["yes", "no"], "prior": ["0.30", "0.70"]},
  "fields": [
    {"name": "household_size", "latent": true, "values": ["small", "large"], "parents": ["young_children"],
     "cpt": {"yes": ["0.25", "0.75"], "no": ["0.70", "0.30"]}},
    {"name": "order.basket_size", "stage": "order", "values": ["small", "medium", "large"], "parents": ["household_size"],
     "cpt": {"small": ["0.55", "0.35", "0.10"], "large": ["0.15", "0.45", "0.40"]},
     "coarsenings": {"two_level": {"small": "small", "medium": "not_small", "large": "not_small"}}},
    {"name": "order.delivery_window", "stage": "order", "values": ["morning", "afternoon", "evening"], "parents": ["young_children"],
     "cpt": {"yes": ["0.45", "0.20", "0.35"], "no": ["0.30", "0.30", "0.40"]},
     "coarsenings": {"daypart": {"morning": "day", "afternoon": "day", "evening": "evening"}}},
    {"name": "order.substitutions_allowed", "stage": "order", "values": ["yes", "no"], "p": ["0.60", "0.40"]},
    {"name": "picking.bulk_items", "stage": "picking", "values": ["none", "some", "many"], "parents": ["household_size", "young_children"],
     "cpt": {"small|yes": ["0.30", "0.50", "0.20"], "small|no": ["0.60", "0.35", "0.05"],
             "large|yes": ["0.10", "0.45", "0.45"], "large|no": ["0.40", "0.45", "0.15"]},
     "coarsenings": {"any": {"none": "none", "some": "any", "many": "any"}}},
    {"name": "picking.out_of_stock", "stage": "picking", "values": ["none", "one", "several"], "p": ["0.65", "0.25", "0.10"],
     "coarsenings": {"any": {"none": "none", "one": "some", "several": "some"}}},
    {"name": "delivery.doorstep_instruction", "stage": "delivery", "values": ["ring_bell", "no_bell", "leave_at_door"],
     "parents": ["order.delivery_window", "young_children"],
     "cpt": {"morning|yes": ["0.55", "0.25", "0.20"], "morning|no": ["0.65", "0.10", "0.25"],
             "afternoon|yes": ["0.30", "0.55", "0.15"], "afternoon|no": ["0.70", "0.00", "0.30"],
             "evening|yes": ["0.50", "0.30", "0.20"], "evening|no": ["0.70", "0.10", "0.20"]},
     "coarsenings": {"attended": {"ring_bell": "attended", "no_bell": "attended", "leave_at_door": "unattended"}}},
    {"name": "delivery.outcome", "stage": "delivery", "values": ["on_time", "late", "failed"], "parents": ["delivery.doorstep_instruction"],
     "cpt": {"ring_bell": ["0.85", "0.10", "0.05"], "no_bell": ["0.80", "0.10", "0.10"], "leave_at_door": ["0.90", "0.09", "0.01"]}}
  ],
  "items": [
    {"name": "large_vehicle", "no_action": ["no"],
     "rules": [{"when": {"any": [{"field": "order.basket_size", "eq": "large"}, {"field": "picking.bulk_items", "eq": "many"}]}, "value": "yes"},
               {"value": "no"}]},
    {"name": "substitution_notice", "no_action": ["no"],
     "rules": [{"when": {"all": [{"field": "order.substitutions_allowed", "eq": "yes"}, {"field": "picking.out_of_stock", "ne": "none"}]}, "value": "yes"},
               {"value": "no"}]},
    {"name": "doorstep_note", "no_action": ["none"],
     "rules": [{"value": {"field": "delivery.doorstep_instruction", "map": {"ring_bell": "none", "no_bell": "no_bell", "leave_at_door": "leave_at_door"}}}]},
    {"name": "follow_up_call", "no_action": ["no"],
     "rules": [{"when": {"field": "delivery.outcome", "in": ["late", "failed"]}, "value": "yes"}, {"value": "no"}]},
    {"name": "slot_reminder", "no_action": [], "rules": [{"value": {"field": "order.delivery_window"}}]}
  ],
  "views": {
    "order": {"description": "order stage only",
              "fields": {"order.basket_size": "keep", "order.delivery_window": "keep", "order.substitutions_allowed": "keep"}},
    "picking": {"description": "picking stage only", "fields": {"picking.bulk_items": "keep", "picking.out_of_stock": "keep"}},
    "delivery": {"description": "delivery stage only", "fields": {"delivery.doorstep_instruction": "keep", "delivery.outcome": "keep"}},
    "linked": {"description": "all three stages, linked",
               "fields": {"order.basket_size": "keep", "order.delivery_window": "keep", "order.substitutions_allowed": "keep",
                          "picking.bulk_items": "keep", "picking.out_of_stock": "keep",
                          "delivery.doorstep_instruction": "keep", "delivery.outcome": "keep"}},
    "coarsened": {"description": "all stages linked, every declared coarsening applied",
                  "fields": {"order.basket_size": {"coarsen": "two_level"}, "order.delivery_window": {"coarsen": "daypart"},
                             "order.substitutions_allowed": "keep", "picking.bulk_items": {"coarsen": "any"},
                             "picking.out_of_stock": {"coarsen": "any"}, "delivery.doorstep_instruction": {"coarsen": "attended"},
                             "delivery.outcome": "keep"}},
    "items_only": {"description": "the checklist answers only", "items": "all"}
  },
  "search": {"max_designs": 5000, "items_plus_fields": 1}
}
